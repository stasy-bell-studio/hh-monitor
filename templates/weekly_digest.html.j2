<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<title>Еженедельная сводка hh-monitor — неделя {{ week_number }}</title>
<style>
  body { font-family: Arial, sans-serif; font-size: 11px; color: #222; margin: 20px; }
  h1 { font-size: 16px; color: #1a3c6e; border-bottom: 2px solid #1a3c6e; padding-bottom: 6px; }
  h2 { font-size: 13px; color: #1a3c6e; margin-top: 20px; }
  h3 { font-size: 12px; color: #333; margin-top: 14px; }
  table { border-collapse: collapse; width: 100%; margin: 8px 0; }
  th { background: #1a3c6e; color: #fff; padding: 5px 8px; text-align: left; font-size: 10px; }
  td { padding: 4px 8px; border-bottom: 1px solid #ddd; vertical-align: top; }
  tr:nth-child(even) td { background: #f5f7fa; }
  .score { font-weight: bold; color: #1a3c6e; }
  .verdict { font-style: italic; color: #555; }
  .candidate-block { border-left: 3px solid #1a3c6e; padding-left: 8px; margin: 6px 0; }
  .candidate-url { color: #1a3c6e; }
  .stats-block { background: #f0f4f9; border: 1px solid #ccd6e5; padding: 8px 12px; margin-top: 16px; }
  .footer { color: #888; font-size: 9px; margin-top: 20px; border-top: 1px solid #ddd; padding-top: 6px; }
</style>
</head>
<body>

<h1>Еженедельная сводка hh-monitor</h1>
<p>Неделя <b>{{ week_number }}</b> · {{ date_from }} — {{ date_to }} · Всего кандидатов: <b>{{ total_candidates }}</b></p>

{% if positions %}
<h2>Сводная таблица по позициям</h2>
<table>
  <tr>
    <th>Позиция</th>
    <th>Новых</th>
    <th>Средний рейтинг</th>
  </tr>
  {% for pos in positions %}
  <tr>
    <td>{{ pos.position_name }}</td>
    <td>{{ pos.count }}</td>
    <td class="score">{{ pos.avg_score }}</td>
  </tr>
  {% endfor %}
</table>

{% for pos in positions %}
<h2>{{ pos.position_name }}</h2>
{% if pos.top_candidates %}
  {% for c in pos.top_candidates %}
  <div class="candidate-block">
    <span class="score">{{ c.score_total }}/100</span>
    · <span class="verdict">{{ c.verdict }}{% if c.real_role %} — {{ c.real_role }}{% endif %}</span>
    · <a href="{{ c.url }}" class="candidate-url">Открыть резюме</a>
    {% if c.comment %}<br><small>{{ c.comment[:150] }}{% if c.comment|length > 150 %}…{% endif %}</small>{% endif %}
  </div>
  {% endfor %}
{% else %}
  <p>Нет кандидатов</p>
{% endif %}
{% endfor %}

{% else %}
<p>Нет кандидатов за отчётный период.</p>
{% endif %}

<div class="stats-block">
  <h3>Статистика парсера за период</h3>
  <table>
    <tr><th>Прогонов</th><th>Снапшотов добавлено</th><th>Дедупликация</th><th>Ошибок</th></tr>
    <tr>
      <td>{{ parser_stats.runs }}</td>
      <td>{{ parser_stats.snapshots_inserted }}</td>
      <td>{{ parser_stats.dedup_rate }}%</td>
      <td>{{ parser_stats.errors }}</td>
    </tr>
  </table>
</div>

<div class="footer">
  Сформировано {{ generated_at }} · hh-monitor
</div>
</body>
</html>
