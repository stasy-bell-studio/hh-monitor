# ============================================================
# hh-monitor — .env.example
# ============================================================
# Copy to .env and fill in values for your environment.
# .env must NEVER be committed to git.
#
# Two deployment profiles:
#   DEV  (local machine)  — ENV=local; use a dedicated dev bot and dev chat.
#   PROD (server only)    — ENV=production; real creds live ONLY on the server.
#
# Rule: prod bot token + prod group id must NEVER appear in a dev .env.
# ============================================================

# ── Profile ──────────────────────────────────────────────────
# DEV:  ENV=local
# PROD: ENV=production
ENV=local

# ── HH.ru OAuth ──────────────────────────────────────────────
HH_CLIENT_ID=<hh-client-id>
HH_CLIENT_SECRET=<hh-client-secret>
HH_REDIRECT_URI=https://localhost:8080/callback
HH_USER_AGENT="SK21Vek HR Monitor (<your-email@example.com>)"
HH_EMPLOYER_ID=<hh-employer-id>      # optional — scopes /resumes search to your employer

# ── Database ─────────────────────────────────────────────────
# DEV (local postgres):
DATABASE_URL=postgresql+asyncpg://hh_monitor:hh_monitor_dev@localhost:5432/hh_monitor
TEST_DATABASE_URL=postgresql+asyncpg://hh_monitor:hh_monitor_dev@localhost:5432/hh_monitor_test
# PROD: postgresql+asyncpg://<prod-user>:<prod-pass>@localhost:5432/<prod-db>

# ── Corporate LLM (OpenAI-compatible API) ────────────────────
LLM_API_KEY=<llm-api-key>
LLM_MODEL=qwen/qwen3.8-27b
LLM_BASE_URL=https://llm.21-vek.spb.ru/v1
# Qwen3 soft switch: append "/no_think" to the last user message (skips chain-of-thought).
LLM_NO_THINK=true
# Per-call HTTP timeout, seconds (reasoning models generate for 1-4 minutes).
LLM_TIMEOUT=300
LLM_PROMPT_VERSION=v3                # bump to invalidate LLM cache when prompt changes
SCORE_FIT_MIN_FOR_LLM=40            # resumes below this fit_score skip LLM

# ── Telegram ─────────────────────────────────────────────────
# DEV profile — set to your own dev bot and dev chat; NEVER use prod values here.
TELEGRAM_BOT_TOKEN=<dev-bot-token>
TELEGRAM_HR_GROUP_ID=<dev-chat-id>          # negative int for supergroup: -100XXXXXXXXX
TELEGRAM_ADMIN_USER_IDS=<your-tg-user-id>  # comma-separated IDs for admin commands
TELEGRAM_SCORE_THRESHOLD=60                 # minimum score to forward a resume card

# PROD profile — on the server, replace the placeholders above with production values:
#   TELEGRAM_BOT_TOKEN=<prod-bot-token>
#   TELEGRAM_HR_GROUP_ID=<prod-group-id>

# TELEGRAM_SEND_ENABLED — controls whether the bot sends outgoing messages.
#   unset (default)  → production-only: sends when ENV=production, silent otherwise.
#   =true            → explicit opt-in: sends even on ENV=local, but ONLY to the
#                      bot/chat configured above. Use this to test sends against a
#                      dedicated dev chat — NEVER combine with prod credentials.
#   =false           → always silent, regardless of ENV.
# TELEGRAM_SEND_ENABLED=true

# Topic IDs for supergroup topic routing (0 = no topic routing)
TELEGRAM_CARDS_TOPIC_ID=0
TELEGRAM_DIGEST_TOPIC_ID=0
TELEGRAM_ADMIN_TOPIC_ID=0

# ── Weekly digest (reference only — scheduling via systemd timer) ─────────────
# WEEKLY_DIGEST_CRON=0 15 * * 5      # Friday 15:00
# WEEKLY_DIGEST_TZ=Europe/Moscow

# ── Runtime ──────────────────────────────────────────────────
LOG_LEVEL=INFO
