# hh.ru OAuth (filled in after app moderation)
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=https://localhost:8080/callback
HH_USER_AGENT="SK21Vek HR Monitor (luk44646@gmail.com)"
HH_EMPLOYER_ID=          # optional — scopes /resumes search to your employer

# Database
DATABASE_URL=postgresql+asyncpg://hh_monitor:hh_monitor_dev@localhost:5432/hh_monitor
TEST_DATABASE_URL=postgresql+asyncpg://hh_monitor:hh_monitor_dev@localhost:5432/hh_monitor_test

# OpenRouter / LLM enrichment
OPENROUTER_API_KEY=              # get from https://openrouter.ai/keys
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324   # change to test cheaper models
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://github.com/Sam44ik/hh-monitor
OPENROUTER_TITLE=hh-monitor
LLM_PROMPT_VERSION=v1            # bump to invalidate cache when prompt changes
SCORE_FIT_MIN_FOR_LLM=60         # resumes below this fit_score skip LLM

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_HR_CHAT_ID=

# Runtime
ENV=local                     # local | prod
LOG_LEVEL=INFO
